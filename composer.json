{
    "name": "dept-of-scrapyard-robotics/ssd1306",
    "description": "Drive SSD1306 monochrome OLED displays over I2C/SPI with PHP",
    "type": "library",
    "version": "0.7.0",
    "keywords": [
        "ssd1306",
        "oled",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "fabricate/nuts-and-bolts": "^0.7.0",
        "gpio/circuits": "^0.7.0",
        "gpio/contracts": "^0.7.0",
        "gpio/digital": "^0.7.0",
        "gpio/i2c": "^0.7.0",
        "gpio/spi": "^0.7.0",
        "tubes/contracts": "^0.7.0"
    },
    "suggest": {
        "ext-posi": "^0.7.0",
        "ext-ftdi": "^0.7.0",
        "microscrap/posix": "^0.7.0",
        "microscrap/mpsse": "^0.7.0"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Displays\\SSD1306\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.7.x-dev"
        },
        "scrapyard-io": {
            "providers": [
                "DeptOfScrapyardRobotics\\Displays\\SSD1306\\SSD1306ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
