{
    "name": "dept-of-scrapyard-robotics/ssd1306",
    "description": "Drive SSD1306 monochrome OLED displays over I2C/SPI with PHP",
    "type": "library",
    "version": "0.6.0",
    "keywords": [
        "ssd1306",
        "framework",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "fabricate/circuits": "^0.6.0",
        "fabricate/contracts": "^0.6.0",
        "fabricate/displays": "^0.6.0",
        "fabricate/framebuffers": "^0.6.0",
        "gpio/i2c": "^0.6.0",
        "gpio/spi": "^0.6.0",
        "gpio/digital": "^0.6.0",
        "gpio/contracts": "^0.6.0"
    },
    "suggest": {
        "ext-posi": "^0.5.0",
        "ext-ftdi": "^0.5.0",
        "microscrap/posix": "^0.5.0",
        "microscrap/mpsse": "^0.5.0"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Displays\\SSD1306\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "scrapyard-io": {
            "providers": [
                "DeptOfScrapyardRobotics\\Displays\\SSD1306\\Providers\\SSD1306ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
